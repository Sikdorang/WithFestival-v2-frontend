{
  "name": "withfestival",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:unit": "pnpm --filter app test:unit",
    "test:integration": "pnpm --filter app test:integration",
    "test:watch": "pnpm --filter app test:watch",
    "test:coverage": "pnpm --filter app test:coverage",
    "test:ci": "pnpm --filter app test:ci"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
